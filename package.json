{
  "name": "desktop-edge-client",
  "version": "1.0.5",
  "description": "POS Chimney Corner",
  "author": "TwinTechSols",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:next": "next dev -p 3000",
    "dev:server": "wait-on tcp:3000 && node start-server.js",
    "build:next": "next build",
    "build:main": "tsc -p tsconfig.main.json && node copy-generated.js",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "start": "electron .",
    "dev": "concurrently \"npm run dev:next\" \"tsc -p tsconfig.main.json -w\" \"npm run dev:server\"",
    "prisma:generate": "prisma generate && prisma generate --schema=prisma/cloud-schema.prisma && node copy-generated.js",
    "prisma:migrate": "prisma migrate dev",
    "package": "cross-env NODE_ENV=production npm run build:next && npm run build:main && electron-builder"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "28.2.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.331.0",
    "next": "^14.1.0",
    "postcss": "^8.4.35",
    "prisma": "^5.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.twintech.chimneycorner",
    "productName": "Chimney Corner POS",
    "copyright": "Copyright © 2026 TwinTechSols",
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "prisma/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/query_engine-*.dll.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}